---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Nav from "../components/Nav.astro";
import Cennik from "../components/Cennik.astro";
import Footer from "../components/Footer.astro";
---

<Layout
    title="Cennik dekoracji świątecznych | Gotowe talerze i aranżacje Pani Kwiat"
    description="Złote talerze, ozdobne aranżacje i kompozycje świąteczne od Pani Kwiat. Sprawdź ceny, wymiary, zdjęcia i zamów od razu przez Facebook Marketplace."
>
    <Header />
    <Nav />
    <main>
        <Cennik />
        <section id="dekoracje" class="cta" data-astro-cid-i344ymn4="">
            <div class="container" data-astro-cid-i344ymn4="">
                <div class="cta-wrapper" data-astro-cid-i344ymn4="">
                    <h2 data-astro-cid-i344ymn4="">Sprawdź moje inne realizacje</h2>
                    <h3 data-astro-cid-i344ymn4="">zobacz kompozycje, które możesz kupić jeszcze dziś!</h3>
                    <div class="btn-wrapper" data-astro-cid-i344ymn4="">
                        <a
                            href="https://www.facebook.com/marketplace/profile/100058801496320/?ref=permalink"
                            target="_blank"
                            class="btn btn-primary"
                            data-astro-cid-i344ymn4=""
                        >
                            przeglądaj gotowe produkty
                        </a>
                    </div>
                </div>
            </div>
        </section>
    </main>
    <Footer />
</Layout>
