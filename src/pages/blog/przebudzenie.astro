---
import "swiper/css";
import "swiper/css/navigation";
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";
import { getBlogPost } from "../../data/blog";

const lang = "pl";
const post = getBlogPost("przebudzenie");

if (!post) {
    throw new Error("Blog post not found");
}
---

<Layout lang={lang} title={`${post.title} – Blog Pani Kwiat`} description={post.excerpt}>
    <Header lang={lang} />
    <Nav lang={lang} />

    <section class="blog-post-hero">
        <div class="container">
            <div class="blog-post-hero__content">
                <a class="blog-back-link" href="/blog/">← Blog</a>
                <p class="blog-post-hero__meta">
                    <time datetime={post.date}>Opublikowano · {post.displayDate}</time>
                </p>
                <h1>{post.title}</h1>
            </div>
        </div>
    </section>

    <main class="blog-page blog-page--single">
        <div class="container">
            <div class="blog-single">
                <article class="blog-article">
                    <div class="blog-article__content">
                        <h2>Przebudzenie po zimie</h2>
                        {post.paragraphs.map((paragraph) => <p>{paragraph}</p>)}

                        <div class="blog-gallery" aria-label="Galeria zdjęć">
                            {
                                post.gallery.map((image, index) => (
                                    <button class="blog-gallery__item" type="button" data-gallery-index={index} aria-label={`Otwórz zdjęcie ${index + 1}`}>
                                        <img src={image} alt="" loading="lazy" width="640" height="480" />
                                    </button>
                                ))
                            }
                        </div>
                    </div>
                </article>

                <aside class="blog-sidebar blog-sidebar--single">
                    <section class="blog-widget blog-author-note">
                        <h2>O autorce</h2>
                        <div class="blog-author-note__card">
                            <img src="/panikwiat.jpg" alt="Pani Kwiat" loading="lazy" width="180" height="180" />
                            <div>
                                <h3>Pani Kwiat</h3>
                                <p>Autorką wpisu jest Pani Kwiat. Na co dzień tworzy autorskie dekoracje kwiatowe i dzieli się doświadczeniem marki Pani Kwiat.</p>
                            </div>
                        </div>
                    </section>
                </aside>
            </div>
        </div>
    </main>

    <dialog id="blog-gallery-dialog" class="blog-gallery-dialog">
        <article>
            <div class="swiper swiper-horizontal">
                <div class="swiper-wrapper">
                    {
                        post.gallery.map((image) => (
                            <div class="swiper-slide">
                                <img src={image} alt="" />
                            </div>
                        ))
                    }
                </div>
                <div class="swiper-button-prev"></div>
                <div class="swiper-button-next"></div>
            </div>
        </article>
        <form method="dialog">
            <button class="close-button" type="submit">X</button>
        </form>
    </dialog>

    <Footer lang={lang} />
</Layout>

<script>
    import Swiper from "https://cdn.jsdelivr.net/npm/swiper@12/swiper-bundle.min.mjs";

    addEventListener("DOMContentLoaded", () => {
        const body = document.body;
        const dialog = document.getElementById("blog-gallery-dialog") as HTMLDialogElement | null;
        const galleryButtons = document.querySelectorAll<HTMLButtonElement>("[data-gallery-index]");
        const swiperElement = dialog?.querySelector<HTMLElement>(".swiper");

        const swiper = swiperElement
            ? new Swiper(swiperElement, {
                  loop: true,
                  navigation: {
                      nextEl: dialog?.querySelector(".swiper-button-next"),
                      prevEl: dialog?.querySelector(".swiper-button-prev"),
                  },
              })
            : null;

        const unlockBody = () => body.classList.remove("pricing-scroll-lock");

        galleryButtons.forEach((button) => {
            button.addEventListener("click", () => {
                if (!dialog || typeof dialog.showModal !== "function") return;

                const index = Number(button.dataset.galleryIndex || 0);
                dialog.showModal();
                body.classList.add("pricing-scroll-lock");
                swiper?.slideToLoop(index, 0);
            });
        });

        dialog?.addEventListener("close", unlockBody);
        dialog?.addEventListener("cancel", unlockBody);
        dialog?.addEventListener("click", (event) => {
            if (event.target === dialog) {
                dialog.close();
            }
        });
    });
</script>

<style>
    .blog-post-hero {
        background-image: linear-gradient(90deg, rgba(21, 21, 21, 0.72), rgba(21, 21, 21, 0.28)), url("/footer.jpg");
        background-position: center;
        background-size: cover;
        color: #fff;
        padding-top: 132px;
        padding-bottom: 56px;
    }

    .blog-post-hero__content {
        max-width: 760px;
    }

    .blog-back-link {
        color: rgba(255, 255, 255, 0.85);
        display: inline-flex;
        margin-bottom: 18px;
        transition: color 0.2s ease;
    }

    .blog-back-link:hover {
        color: #fff;
    }

    .blog-post-hero__meta,
    .blog-widget h2 {
        font-size: 12px;
        font-weight: 700;
        letter-spacing: 0.14em;
        text-transform: uppercase;
    }

    .blog-post-hero__meta {
        color: rgba(255, 255, 255, 0.9);
        margin-bottom: 18px;
    }

    .blog-post-hero h1 {
        color: #fff;
        margin-bottom: 0;
        text-align: left;
    }

    .blog-page {
        background: #f7f7f2;
        padding-top: 40px;
        padding-bottom: 56px;
    }

    .blog-single {
        display: grid;
        gap: 28px;
    }

    .blog-article,
    .blog-widget {
        background: rgba(255, 255, 255, 0.92);
        border: 1px solid rgba(109, 142, 77, 0.12);
        border-radius: 24px;
        box-shadow: 0 24px 60px -42px rgba(21, 21, 21, 0.32);
        padding: 24px;
    }

    .blog-article__content h2,
    .blog-widget h2,
    .blog-author-note__card h3 {
        color: #151515;
        text-align: left;
        text-shadow: none;
    }

    .blog-article__content h2 {
        font-size: 28px;
        margin-bottom: 18px;
    }

    .blog-article__content p {
        color: #404040;
        font-size: 15px;
        line-height: 1.95;
    }

    .blog-gallery {
        display: grid;
        gap: 16px;
        grid-template-columns: 1fr;
        margin-top: 32px;
    }

    .blog-gallery__item {
        aspect-ratio: 4 / 3;
        border-radius: 20px;
        cursor: zoom-in;
        display: block;
        overflow: hidden;
        padding: 0;
        width: 100%;
    }

    .blog-gallery__item img {
        height: 100%;
        object-fit: cover;
        transition: transform 0.35s ease;
        width: 100%;
    }

    .blog-gallery__item:hover img {
        transform: scale(1.04);
    }

    .blog-sidebar {
        display: grid;
        gap: 20px;
        align-content: start;
    }

    .blog-widget h2 {
        margin-bottom: 22px;
    }

    .blog-author-note__card {
        display: grid;
        gap: 18px;
    }

    .blog-author-note__card img {
        border-radius: 18px;
        height: 180px;
        object-fit: cover;
        width: 100%;
    }

    .blog-author-note__card h3 {
        margin-bottom: 10px;
    }

    .blog-author-note__card p {
        color: #4f4f4f;
        margin-bottom: 0;
    }

    .blog-gallery-dialog {
        background: transparent;
        border: none;
        height: 100vh;
        inset: 0;
        max-height: 100vh;
        max-width: 100vw;
        overflow: hidden;
        padding: 0;
        position: fixed;
        width: 100vw;
    }

    .blog-gallery-dialog::backdrop {
        background: rgba(0, 0, 0, 0.8);
    }

    .blog-gallery-dialog:not([open]) {
        display: none;
    }

    .blog-gallery-dialog article {
        display: grid;
        height: 100%;
        margin: 0 auto;
        max-height: 90vh;
        max-width: min(900px, 90vw);
        padding: 10px;
        place-items: center;
    }

    .blog-gallery-dialog .swiper {
        height: 100%;
        max-height: 90vh;
        width: 100%;
    }

    .blog-gallery-dialog .swiper-slide {
        display: grid;
        height: 100%;
        place-items: center;
    }

    .blog-gallery-dialog img {
        background: transparent;
        border-radius: 8px;
        display: block;
        height: 100%;
        max-height: 90vh;
        object-fit: contain;
        width: 100%;
    }

    .blog-gallery-dialog .close-button {
        align-items: center;
        background: var(--primary);
        border: none;
        border-radius: 8px;
        color: #fff;
        cursor: pointer;
        display: grid;
        font-size: 18px;
        font-weight: 700;
        height: 36px;
        justify-content: center;
        position: absolute;
        right: 12px;
        top: 12px;
        transition: 0.3s ease-in-out all;
        width: 36px;
        z-index: 2;
    }

    .blog-gallery-dialog .close-button:hover {
        background: var(--primary-dark);
    }

    @media screen and (min-width: 768px) {
        .blog-gallery {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }

    @media screen and (min-width: 1200px) {
        .blog-post-hero {
            padding-top: 170px;
            padding-bottom: 88px;
        }

        .blog-page {
            padding-top: 56px;
            padding-bottom: 88px;
        }

        .blog-single {
            grid-template-columns: minmax(0, 1.45fr) minmax(320px, 0.75fr);
            gap: 32px;
        }

        .blog-sidebar--single {
            position: sticky;
            top: 116px;
        }

        .blog-article,
        .blog-widget {
            padding: 32px;
        }

        .blog-author-note__card {
            align-items: center;
            grid-template-columns: 124px 1fr;
        }

        .blog-author-note__card img {
            height: 124px;
        }

        .blog-gallery-dialog .close-button {
            font-size: 20px;
            height: 48px;
            position: fixed;
            right: 48px;
            top: 48px;
            width: 48px;
        }
    }
</style>
